    <system:String x:Key="UiRuntimeMissingMessage">هسته وردایجنت پیدا نشد.</system:String>
    <system:String x:Key="UiChooseDocxMessage">ابتدا فایل DOCX را انتخاب کنید.</system:String>
    <system:String x:Key="UiChooseTemplateMessage">ابتدا فایل تمپلیت DOCX را انتخاب کنید.</system:String>
    <system:String x:Key="UiChooseProfileMessage">پروفایل هنوز انتخاب نشده است. ابتدا «تشخیص نوع سند» را اجرا کنید؛ در نتیجه قطعی، پروفایل خودکار اعمال می‌شود.</system:String>
    <system:String x:Key="UiOutputFolderMissingMessage">پوشه خروجی هنوز ایجاد نشده است.</system:String>
    <system:String x:Key="UiCustomProfileFormat">پروفایل سفارشی {0}</system:String>
    <system:String x:Key="UiCustomProfilePlain">پروفایل سفارشی</system:String>
