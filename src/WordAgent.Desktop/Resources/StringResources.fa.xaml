    <system:String x:Key="UiTemplateOperation">تحلیل تمپلیت</system:String>
    <system:String x:Key="UiTemplateApplyOperation">اعمال قطعی تمپلیت</system:String>

    <system:String x:Key="ProfileFormalAdminTechnicalProposalFa">پیشنهاده رسمی/اداری/فنی</system:String>
    <system:String x:Key="ProfileQuestionnaireAssessmentFa">پرسش‌نامه ارزیابی</system:String>
