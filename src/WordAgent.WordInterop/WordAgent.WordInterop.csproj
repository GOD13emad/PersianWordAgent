<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>WordAgent.WordInterop</AssemblyName>
    <RootNamespace>WordAgent.WordInterop</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Office.Interop.Word" />
    <ProjectReference Include="..\WordAgent.Core\WordAgent.Core.csproj" />
  </ItemGroup>

  <!--
    No-PIA deployment: PackageReference leaves EmbedInteropTypes=false by default.
    Mark the resolved Word interop reference as embeddable so the compiled assembly
    does not require Microsoft Office PIA assemblies (notably office.dll) at runtime.
  -->
  <Target Name="WordAgentEmbedMicrosoftOfficeInteropWord"
          AfterTargets="ResolveReferences"
          BeforeTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)' == 'Microsoft.Office.Interop.Word' AND '%(ReferencePath.NuGetPackageId)' == 'Microsoft.Office.Interop.Word'">
        <EmbedInteropTypes>true</EmbedInteropTypes>
      </ReferencePath>
    </ItemGroup>
  </Target>

  <!-- WORDAGENT R8R27R4R2R1R4R3: design-time-only Office Word PIA / Embedded Interop Types deployment. -->
  <ItemGroup>
    <PackageReference Update="Microsoft.Office.Interop.Word">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="WordAgentEmbedMicrosoftOfficeInteropWordTypes_R8R27R4R2R1R4R3" AfterTargets="ResolveReferences" BeforeTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(ReferencePath.FileName)' == 'Microsoft.Office.Interop.Word' And '%(ReferencePath.NuGetPackageId)' == 'Microsoft.Office.Interop.Word'">
        <EmbedInteropTypes>true</EmbedInteropTypes>
        <Private>false</Private>
      </ReferencePath>
    </ItemGroup>
    <Message Importance="high" Condition="'%(ReferencePath.FileName)' == 'Microsoft.Office.Interop.Word'" Text="WORDAGENT_INTEROP_REFERENCE=%(ReferencePath.FileName)|Embed=%(ReferencePath.EmbedInteropTypes)|Private=%(ReferencePath.Private)|NuGet=%(ReferencePath.NuGetPackageId)" />
  </Target>
</Project>


